import { LineEdit, Button, ScrollView } from "std-widgets.slint";

struct AppEntry {
    name: string,
    icon: string,
    exec: string,
    category: string,
}

component FrutigerLauncher inherits Rectangle {
    in property <bool> is_open: false;
    in property <string> search_text: "";
    in property <[AppEntry]> apps: [
        { name: "Foot Terminal", icon: "📟", exec: "foot", category: "System" },
        { name: "Alacritty", icon: "⚡", exec: "alacritty", category: "System" },
        { name: "Firefox", icon: "🌐", exec: "firefox", category: "Internet" },
        { name: "File Manager", icon: "📁", exec: "thunar", category: "Files" },
        { name: "Text Editor", icon: "📝", exec: "gedit", category: "Utility" },
        { name: "Task Manager", icon: "📊", exec: "htop", category: "System" },
        { name: "System Settings", icon: "⚙️", exec: "settings", category: "Preferences" },
    ];

    callback launch_app(string);
    callback close_launcher();

    width: 380px;
    height: 480px;
    border-radius: 18px;
    background: @linear-gradient(165deg, #ffffff55 0%, #1a608acc 40%, #082d46f2 100%);
    border-width: 1.5px;
    border-color: #ffffffcc;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header with Frutiger Orb
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: @linear-gradient(180deg, #88f0ff 0%, #00a2e8 60%, #004b75 100%);
                border-width: 1.5px;
                border-color: #ffffff;

                Text {
                    text: "🫧";
                    font-size: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Frutiger Aero Menu";
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: "Applications & System";
                    color: #ffffffaa;
                    font-size: 11px;
                }
            }
        }

        // Search Box with Glass Inset
        Rectangle {
            height: 36px;
            border-radius: 10px;
            background: #00000033;
            border-width: 1px;
            border-color: #ffffff44;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    text: "🔍";
                    font-size: 13px;
                    vertical-alignment: center;
                }

                LineEdit {
                    placeholder-text: "Search programs...";
                    font-size: 13px;
                    edited(text) => {
                        // Search filter
                    }
                }
            }
        }

        // App List
        ScrollView {
            VerticalLayout {
                spacing: 6px;

                for app in root.apps: Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: touch.has-hover ? #ffffff33 : #ffffff10;
                    border-width: 1px;
                    border-color: touch.has-hover ? #ffffff88 : transparent;

                    touch := TouchArea {
                        clicked => {
                            root.launch_app(app.exec);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        alignment: start;

                        Text {
                            text: app.icon;
                            font-size: 20px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: app.name;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: app.category;
                                color: #ffffff88;
                                font-size: 10px;
                            }
                        }
                    }
                }
            }
        }

        // Bottom Power Bar
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: #ffffff20;
                border-width: 1px;
                border-color: #ffffff44;

                TouchArea {
                    clicked => { root.launch_app("spawn:reboot"); }
                }
                Text { text: "🔄"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: #ff444440;
                border-width: 1px;
                border-color: #ff8888aa;

                TouchArea {
                    clicked => { root.launch_app("spawn:poweroff"); }
                }
                Text { text: "⏻"; color: #ffffff; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

component FrutigerPanel inherits Rectangle {
    in property <string> time_text: "12:00";
    in property <string> current_window_title: "Frutiger Aero Desktop";
    in property <int> active_workspace: 1;
    in property <bool> launcher_open: false;

    callback toggle_launcher();
    callback workspace_selected(int);
    callback launch_app(string);

    height: 40px;
    background: @linear-gradient(180deg, #ffffff44 0%, #1e6fa033 50%, #0d385566 100%);
    border-width: 1px;
    border-color: #ffffff88;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: space-between;

        // Left Section: Frutiger Orb Menu & Workspaces
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            // Glossy Aqua Orb Button
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: @linear-gradient(180deg, #66e0ffcc 0%, #0099ccdd 60%, #004466ee 100%);
                border-width: 1.5px;
                border-color: #ffffffcc;

                TouchArea {
                    clicked => { root.toggle_launcher(); }
                }

                Text {
                    text: "🫧";
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Workspaces 1..4
            HorizontalLayout {
                spacing: 4px;
                for ws in [1, 2, 3, 4]: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: root.active_workspace == ws ? #ffffff66 : #ffffff1a;
                    border-width: 1px;
                    border-color: root.active_workspace == ws ? #ffffffcc : #ffffff33;

                    TouchArea {
                        clicked => { root.workspace_selected(ws); }
                    }

                    Text {
                        text: ws;
                        color: root.active_workspace == ws ? #ffffff : #ffffffaa;
                        font-weight: root.active_workspace == ws ? 700 : 400;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Center Section: Active Window / Desktop Title
        HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: #ffffff15;
                border-width: 1px;
                border-color: #ffffff22;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.current_window_title;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Right Section: Tray & Clock
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: #ffffff18;
                border-width: 1px;
                border-color: #ffffff33;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text { text: "🔊"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "📶"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "🔋"; font-size: 12px; vertical-alignment: center; }
                    Text {
                        text: root.time_text;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component ShellWindow inherits Window {
    title: "Frutiger Shell";
    no-frame: true;
    background: transparent;

    in-out property <string> time_text: "18:00";
    in-out property <string> current_window_title: "Frutiger Aero Desktop";
    in-out property <int> active_workspace: 1;
    in-out property <bool> launcher_open: false;

    callback toggle_launcher();
    callback workspace_selected(int);
    callback launch_app(string);

    VerticalLayout {
        alignment: start;
        spacing: 12px;

        FrutigerPanel {
            time_text: root.time_text;
            current_window_title: root.current_window_title;
            active_workspace: root.active_workspace;
            launcher_open: root.launcher_open;
            toggle_launcher => {
                root.launcher_open = !root.launcher_open;
                root.toggle_launcher();
            }
            workspace_selected(ws) => {
                root.active_workspace = ws;
                root.workspace_selected(ws);
            }
            launch_app(app) => { root.launch_app(app); }
        }

        if root.launcher_open: HorizontalLayout {
            padding-left: 12px;
            alignment: start;
            FrutigerLauncher {
                is_open: root.launcher_open;
                launch_app(exec) => {
                    root.launcher_open = false;
                    root.launch_app(exec);
                }
                close_launcher => {
                    root.launcher_open = false;
                }
            }
        }
    }
}
